# Security headers for Cloudflare Pages or Netlify, if you ever move there.
# GitHub Pages ignores this file; the app's own security rules are in index.html.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/sw.js
  Cache-Control: no-cache
/js/config.js
  Cache-Control: no-cache
